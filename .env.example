# Void X Arena Environment Configuration

# Database Configuration (PostgreSQL everywhere: Dev, Staging, Prod)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/void_x_arena?schema=public"

# Authentication & Security Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_here_min_32_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# App & Client Config
NEXT_PUBLIC_SITE_URL="https://voidxarena.gg"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_ANDROID_APK_URL="https://voidxarena.gg/downloads/voidxarena-v1.0.apk"
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/voidxarena"
NEXT_PUBLIC_WHATSAPP_URL="https://whatsapp.com/channel/voidxarena"
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/voidxarena"

# Payment Gateway (Cashfree Configuration)
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_ENV="SANDBOX"
CASHFREE_WEBHOOK_SECRET="YOUR_CASHFREE_WEBHOOK_SECRET"

# System Versioning & Maintenance Control
APP_VERSION="1.0.0"
MIN_SUPPORTED_APP_VERSION="1.0.0"
MAINTENANCE_MODE="false"
MAINTENANCE_MESSAGE="Void X Arena is undergoing scheduled server maintenance. We will be back shortly."
